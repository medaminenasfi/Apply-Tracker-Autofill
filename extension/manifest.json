{
  "manifest_version": 3,
  "name": "Apply Tracker Autofill",
  "version": "1.0.0",
  "description": "Autofill job application forms and save applications to your Apply Tracker dashboard",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://localhost:3001/*"],
      "js": ["auth-content.js"],
      "run_at": "document_end"
    }
  ]
}
