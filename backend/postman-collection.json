        {
          "name": "Upload CV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ACCESS_TOKEN_HERE",
                "description": "Replace YOUR_ACCESS_TOKEN_HERE with actual token from register/login response"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "cv",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "http://localhost:3000/profile/cv",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["profile", "cv"]
            },
            "description": "Upload CV file (PDF only, max 5MB). Protected route - requires valid JWT token."
          }
        }
