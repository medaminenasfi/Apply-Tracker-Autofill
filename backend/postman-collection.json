              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "logout"]
            },
            "description": "Logout placeholder endpoint"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ACCESS_TOKEN_HERE",
                "description": "Replace YOUR_ACCESS_TOKEN_HERE with actual token from register/login response"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "me"]
            },
            "description": "Get current logged-in user (protected route - requires valid JWT token)"
          }
        }
      ]
    },
