# Backend environment variables (copy to backend/.env)

MONGODB_URI=mongodb://localhost:27017/apply-tracker
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=3000
FRONTEND_URL=http://localhost:3001

# Beta launch — cap registrations (0 = unlimited)
BETA_MAX_USERS=50

# Google OAuth (production: create credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email — reminders + password reset (SMTP_USER/PASS or EMAIL_USER/PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@applyflow.app
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@applyflow.app

# Admin bootstrap
ADMIN_SETUP_SECRET=change-me-before-production

# Stripe V2 — required for Pro checkout
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# OpenAI (optional — AI match score; heuristic fallback if empty)
OPENAI_API_KEY=

# Cron secret (optional) — protect manual reminder trigger
CRON_SECRET=change-me
